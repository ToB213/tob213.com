<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} - {% endif %}Tob</title>
    <meta
      name="description"
      content="{{ description | default('Tob is an engineer who writes occasionally and keeps a quiet personal index of work, notes, and resume.') }}"
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Tob</a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/writing/">Writing</a>
        <a href="/work/">Work</a>
        <a href="/resume/">Resume</a>
        <a href="/about/">About</a>
      </nav>
    </header>

    <main class="page">{{ content | safe }}</main>
  </body>
</html>
