---
layout: base.njk
---

<article class="article">
  <header class="article-header">
    <p class="kicker">{{ work.label }}</p>
    <h1>{{ title }}</h1>
    <p class="article-meta">{{ work.year }} / {{ work.type }}</p>
  </header>

  <div class="prose">
    {% if work.summary %}
    <p>{{ work.summary | safe }}</p>
    {% endif %} {% if work.media %}
    <figure class="article-figure">
      {% if work.media.type == "pdf" %}
      <embed src="{{ work.media.src }}" type="application/pdf" width="100%" height="600px" />
      {% else %}
      <img src="{{ work.media.src }}" alt="{{ work.media.alt }}" loading="lazy" decoding="async" />
      {% endif %} {% if work.media.caption %}
      <figcaption>{{ work.media.caption }}</figcaption>
      {% endif %}
    </figure>
    {% endif %} {% if work.details %}
    <dl class="detail-list">
      {% for detail in work.details %}
      <div>
        <dt>{{ detail.label }}</dt>
        <dd>
          {% if detail.html %} {{ detail.html | safe }} {% else %} {{ detail.value | safe }} {%
          endif %}
        </dd>
      </div>
      {% endfor %}
    </dl>
    {% endif %}
  </div>
</article>
